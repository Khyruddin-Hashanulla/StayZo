<%layout("/Layouts/boilerplate")%>

<!-- Scrollable filter section -->
<div class="container-fluid mt-3 px-3 sticky-filters">
  <div class="d-flex flex-nowrap overflow-auto" id="filters">
    <!-- Each filter item -->
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Trending" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-fire fa-lg"></i></div>
      <p>Trending</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Room" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-bed fa-lg"></i></div>
      <p>Room</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Cities" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-mountain-city fa-lg"></i></div>
      <p>Cities</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Mountains" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-mountain-sun fa-lg"></i></div>
      <p>Mountains</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Castles" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-brands fa-fort-awesome fa-lg"></i></div>
      <p>Castles</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Pool" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-person-swimming fa-lg"></i></div>
      <p>Pool</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Camping" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-tent fa-lg"></i></div>
      <p>Camping</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Farms" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-cow fa-lg"></i></div>
      <p>Farms</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Arctic" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-snowflake fa-lg"></i></div>
      <p>Arctic</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Beach" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-umbrella-beach fa-lg"></i></div>
      <p>Beach</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Ocean" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-water fa-lg"></i></div>
      <p>Ocean</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Towers" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-gopuram fa-lg"></i></div>
      <p>Towers</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Park" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-republican fa-lg"></i></div>
      <p>Park</p>
      </a>
    </div>
    <div class="text-center filter me-4">
      <a href="/listings/search?category=Party" class="text-center filter text-decoration-none text-dark">
      <div><i class="fa-solid fa-champagne-glasses fa-lg"></i></div>
      <p>Party</p>
      </a>
    </div>

    <!-- Toggle (optional scrollable or fix to right) -->
    <div class="d-none d-xl-flex align-items-center tax-toggle mt-2 ms-3">
      <div class="form-check form-switch">
        <input
          class="form-check-input"
          type="checkbox"
          role="switch"
          id="switchCheckDefault"
        />
        <label class="form-check-label" for="switchCheckDefault"
          >Display Taxes</label
        >
      </div>
    </div>
  </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-1">
  <% for(let listing of allListings){ %>
  <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
      <img
        src="<%=listing.image.url%>"
        class="card-img-top"
        alt="listing image"
        style="height: 18rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b> <%= listing.title %></b>
          <br />
          &#8377;<%=listing.price.toLocaleString("en-IN")%> / night
          <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>
<script src="/JS/toggle.js"></script>
