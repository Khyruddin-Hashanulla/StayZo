<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-btn i {
    margin-right: 0.3rem;
    display: inline;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.3rem 2rem;
    min-width: 200px;
  }

  @media (max-width: 767px) {
    .container-fluid {
      background-color: #fff;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="d-md-flex w-100 justify-content-between align-items-center">
        <div class="navbar-nav" id="left-nav">
          <a class="nav-link" href="/listings">Explore</a>
        </div>

        <form
          class="d-flex my-2 my-md-0"
          role="search"
          id="nav-search"
          action="/listings/search"
          method="GET"
        >
          <input
            class="form-control search-inp me-2"
            type="search"
            placeholder="Search destinations"
            name="query"
            aria-label="Search"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>

        <div class="navbar-nav" id="right-nav">
          <a class="nav-link" href="/listings/new">Your home</a>
          <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
          <% } %> <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>
